# Official ROCm PyTorch/vLLM base image for AMD Instinct GPUs
FROM rocm/vllm:latest

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /vllm-workspace

EXPOSE 8001
ENTRYPOINT ["python3", "-m", "vllm.entrypoints.openai.api_server"]
CMD ["--model", "meta-llama/Llama-3.1-8B-Instruct", "--port", "8001", "--host", "0.0.0.0", "--max-model-len", "32768"]
