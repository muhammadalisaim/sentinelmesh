# ========================================================
# SentinelMesh Configuration Template
# AMD Developer Hackathon: ACT III
# ========================================================

ENV=development
DEBUG=true
SECRET_KEY=sentinelmesh_super_secret_jwt_key_2026_amd_hackathon

# Database (PostgreSQL with SQLite fallback)
DATABASE_URL=sqlite:///./sentinelmesh.db

# Message Queue & Vector Store
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# AMD ROCm vLLM Endpoint
VLLM_API_BASE=http://localhost:8001/v1
VLLM_API_KEY=EMPTY
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
LLM_TIMEOUT=60.0
LLM_TEMPERATURE=0.1

# AMD Hardware Telemetry
AMD_GPU_MODEL=AMD Instinct MI250X (128GB HBM2e)
AMD_ROCM_VERSION=ROCm 6.2
